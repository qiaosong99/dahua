# 运行环境（体积大，不入库；部署时放置 Node.js 与 Git）
runtime/

# 依赖
node_modules/

# 敏感配置（含密码），使用 config.example.json 复制生成
server/config.json

# 自签名证书私钥
server/certs/

# 访客照片与数据库
server/photos/
server/*.db
server/*.db-wal
server/*.db-shm

# 构建产物（由 web 构建生成）
server/public/

# NetSDK 网关运行包（jar+DLL 体积大，由 dh-netsdk-http 执行 mvn clean package -Phttp 后自行复制生成）
gateway/

# NetSDK 网关构建产物
dh-netsdk-http/target/

# 临时/日志
*.log
*.tmp
*.png
Thumbs.db
